# Copy this file to .env for local development (never commit .env).
# Vite only reads VITE_* into the browser bundle. Server/API secrets
# belong in Supabase Edge Function secrets, not in this file's real values
# and never as VITE_* variables.

# --- Required for `npm run build` / `npm run dev` ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
VITE_PUBLIC_BASE_URL=http://localhost:8080

# Optional: override auth redirect (magic link / OAuth). Leave unset
# to use VITE_PUBLIC_BASE_URL or window.location.origin.
# VITE_AUTH_REDIRECT_OVERRIDE=http://localhost:8080

# Feature flags / public marketing IDs
VITE_ADS_ENABLED=false
VITE_ADSENSE_EDGE_LEFT_SLOT=
VITE_ADSENSE_EDGE_RIGHT_SLOT=
VITE_ADSENSE_MOBILE_FEED_SLOT=
VITE_AMAZON_PARTNER_TAG=yourtag-21
VITE_PINTEREST_TAG_ID=
VITE_I18N_ENABLED=true

# Leave these unset (or 0) in production builds.
VITE_DEBUG=0
VITE_DB_TRACE=0

# --- Local-only / test (not used by the Vite production build) ---
PLAYWRIGHT_BASE_URL=http://localhost:8080

# --- Do NOT put these in VITE_* or in GitHub Actions build env. ---
# Set them as Supabase Edge Function secrets instead:
#   SUPABASE_SERVICE_ROLE_KEY
#   RAINFOREST_API_KEY
#   AMAZON_PAAPI_ACCESS_KEY
#   AMAZON_PAAPI_SECRET_KEY
#   AMAZON_PAAPI_PARTNER_TAG / AMZ_ASSOC_TAG / RAINFOREST_ASSOC_TAG
#   AMAZON_PAAPI_REGION / AMAZON_MARKETPLACE / CATALOG_PROVIDER
#   RESEND_API_KEY or SENDGRID_API_KEY
#   SCHEDULER_SECRET
#   FCM_SERVER_KEY
